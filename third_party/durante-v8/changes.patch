+  INSERT(INSTR_CREATE_mov_st(ctx, instructions, tmp));
+  INSERT(INSTR_CREATE_mov_st(ctx, checkpoint, OPND_CREATE_INT32(0)));
+  restore_charge_state(ctx, bb, where);
+  INSERT(INSTR_CREATE_jmp(ctx, opnd_create_instr(done)));
