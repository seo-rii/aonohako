# Non-root development control plane forwarding execution to a hardened runner.
AONOHAKO_DEPLOYMENT_TARGET=dev
AONOHAKO_EXECUTION_TRANSPORT=remote
AONOHAKO_SANDBOX_BACKEND=none
AONOHAKO_INBOUND_AUTH=none
AONOHAKO_REMOTE_RUNNER_URL=https://runner.internal
AONOHAKO_REMOTE_RUNNER_AUTH=none
AONOHAKO_REMOTE_STRICT_PROTOCOL=false
AONOHAKO_MAX_PENDING_QUEUE=16
AONOHAKO_MAX_ACTIVE_STREAMS=64
AONOHAKO_MAX_ACTIVE_UPLOADS=0
AONOHAKO_MAX_PRINCIPAL_ACTIVE_UPLOADS=0
AONOHAKO_NETWORK_EGRESS_ISOLATED=false
AONOHAKO_DEFAULT_RUST_CRATE_MODE=stdlib
AONOHAKO_ALLOW_REQUEST_RUST_INSTALLED_CRATES=true
AONOHAKO_DEFAULT_PYTHON_LIBRARY_MODE=stdlib
AONOHAKO_ALLOW_REQUEST_PYTHON_INSTALLED_LIBRARIES=true
