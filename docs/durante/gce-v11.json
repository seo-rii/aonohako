      "assembly": "/* A libc-free program with 623 nominal operand bytes. Keep the sentinel live\n * in XMM0 across block entries, store checkpoints and REP observations. */\n.global _start\n.text\n_start:\n    fxsave64 state(%rip)             /* 512 fixed bytes */\n    mov $1, %eax\n    cpuid\n    bt $27, %ecx                     /* OSXSAVE */\n    jnc .Lstart\n    xor %eax, %eax\n    xor %edx, %edx\n    xsave64 state(%rip)              /* runtime-selected width contributes zero */\n.Lstart:\n    lea input(%rip), %rsi\n    lea buffer(%rip), %rdi\n    prefetchnta (%rsi)\n    nopl 0(%rsi)\n    movdqu (%rsi), %xmm0             /* 16 */\n    movb (%rsi), %al\n    movw (%rsi), %ax\n    movl (%rsi), %eax\n    movq (%rsi), %rax                /* reads 1+2+4+8 */\n    movb %al, (%rdi)\n    movw %ax, (%rdi)\n    movl %eax, (%rdi)\n    movq %rax, (%rdi)                /* writes 1+2+4+8 */\n    addl $1, (%rdi)                  /* RMW 4+4 */\n    push %rax\n    pop %rax                         /* implicit stack write/read 8+8 */\n    mov $3, %ecx\n.Lloop:\n    movb (%rsi), %al                 /* 3 visits at 1 byte each */\n    dec %ecx\n    jnz .Lloop\n    rep movsb                        /* 1+1 even at RCX=0 */\n    mov $7, %ecx\n    rep movsb                        /* 1+1, independent of RCX */\n    mov $2, %ecx\n    rep stosw                        /* 2 */\n    movdqu %xmm0, 16(%rdi)          /* 16 */\n    pcmpeqb input(%rip), %xmm0       /* 16, verifies live XMM0 */\n    pmovmskb %xmm0, %edi\n    xor $65535, %edi\n    setne %dil\n    movzbl %dil, %edi\n    mov $60, %eax\n    syscall\n.section .rodata\n.balign 16\ninput:\n    .quad 0x0123456789abcdef, 0xfedcba9876543210\n.bss\n.balign 64\nstate:\n    .skip 4096\nbuffer:\n    .skip 64\n.section .note.GNU-stack,\"\",@progbits\n",
