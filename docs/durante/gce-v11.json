      "assembly": "/* Linux x86-64, no libc, threads, child processes or generated code.\n * Each fixture writes one independently predictable little-endian uint64.\n * Common write/exit: 8 instructions. REP counts each REP entry once.\n */\n.global _start\n.text\n_start:\n#if FIXTURE == 1\n    /* 2 setup + 2 * 2,000,000 loop + 1 store + 8 common. */\n    mov $20000000, %ecx\n    xor %r8d, %r8d\n1:  add $3, %r8\n    loop 1b\n    mov %r8, payload(%rip)\n#elif FIXTURE == 2\n    /* 2 setup + 10 * 128 body + 2 result + 8 common. */\n    mov $128, %r9d\n    cld\n1:  lea source(%rip), %rdi\n    mov $0x5a, %al\n    mov $65536, %ecx\n    rep stosb\n    lea source(%rip), %rsi\n    lea target(%rip), %rdi\n    mov $65536, %ecx\n    rep movsb\n    dec %r9d\n    jnz 1b\n    mov target+65528(%rip), %r8\n    mov %r8, payload(%rip)\n#elif FIXTURE != 0\n#error Unknown fixed overhead fixture\n#endif\n    mov $1, %eax\n    mov $1, %edi\n    lea payload(%rip), %rsi\n    mov $8, %edx\n    syscall\n    mov $60, %eax\n    xor %edi, %edi\n    syscall\n.data\n.align 8\npayload: .quad 0x0123456789abcdef\n.bss\n.align 64\nsource: .skip 65536\ntarget: .skip 65536\n.section .note.GNU-stack,\"\",@progbits\n",
